# WikiHole — Local Development Environment
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Notes ─────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is server-side only (api/quiz.js).
# Add it to Vercel env vars — never put it here, it would be exposed in the bundle.
#
# In local dev, AccessGate auto-bypasses auth (import.meta.env.DEV = true),
# so Supabase vars are optional unless you're testing the subscription gate.
